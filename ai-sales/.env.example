# AI Sales module — environment variables (PLACEHOLDERS ONLY).
# Set real values in Netlify → Site configuration → Environment variables, scope "Functions".
# Never put these in the browser, in the repo, or in netlify.toml. Changing them needs a redeploy.

# Server kill switch. Anything other than "true" keeps every /api/sales/* function inert.
AI_SALES_ENABLED=false

# Supabase (URL/anon key default to the existing public project values; override only if the project moves)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=sb_publishable_xxxxxxxxxxxxxxxx
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key          # required for WhatsApp, follow-ups and calendar (Phase 4); also invitations and the AI run log

# LLM (Phase 3)
ANTHROPIC_API_KEY=replace-with-anthropic-api-key

# WhatsApp Business Platform — Meta Cloud API (Phase 4)
WHATSAPP_ACCESS_TOKEN=replace-with-system-user-token
WHATSAPP_PHONE_NUMBER_ID=000000000000000
WHATSAPP_APP_SECRET=replace-with-app-secret                       # verifies X-Hub-Signature-256 on webhooks
WHATSAPP_VERIFY_TOKEN=replace-with-a-long-random-string           # used once when registering the webhook
# WHATSAPP_API_VERSION=v23.0                                      # optional: Graph API version
# WHATSAPP_BUSINESS_ACCOUNT_ID=000000000000000                   # optional: default for the connection check (Integrations)

# Google Calendar (Phase 4)
GOOGLE_CALENDAR_ID=your-calendar-id@group.calendar.google.com
GOOGLE_SERVICE_ACCOUNT_EMAIL=ai-sales@your-gcp-project.iam.gserviceaccount.com
# Private key: EITHER here (paste the whole "-----BEGIN PRIVATE KEY-----…" value; \n escapes are fine),
# OR in Supabase Vault as secret "google_private_key" (keeps Netlify under its 4 KB limit for function variables).
# GOOGLE_PRIVATE_KEY=-----BEGIN PRIVATE KEY-----\nreplace-me\n-----END PRIVATE KEY-----\n
